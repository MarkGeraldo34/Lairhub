# "testnet" (chain 1983) while developing, "mainnet" (chain 1990) for the hackathon submission
NEXT_PUBLIC_NETWORK=testnet
# Address printed by `npx hardhat run scripts/deploy.js --network qieTestnet|qieMainnet`
NEXT_PUBLIC_CONTRACT_ADDRESS=

# --- Keeper (server only): pays hosts whose guest never confirmed, via release() ---
# Any funded wallet works: release() is permissionless, so this key can't touch escrowed funds.
# On Cloudflare these are Worker SECRETS (npx wrangler secret put ...), not build variables.
KEEPER_PRIVATE_KEY=
# The keeper-cron Worker sends this as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
